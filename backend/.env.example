# 应用配置
DEBUG=true
SECRET_KEY=chemlearn-secret-key-change-in-production-2026

# 数据库（生产环境建议 PostgreSQL）
DATABASE_URL=sqlite+aiosqlite:///./chemlearn.db

# 内置管理员
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@chemlearn.local

# AI 问答（OpenAI 兼容接口，可接豆包/DeepSeek/通义等）
AI_API_BASE=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# 邮箱 SMTP（注册验证码）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ChemLearn <noreply@chemlearn.com>
SMTP_USE_TLS=true
# 注册强制邮箱验证码（生产保持 true）
REQUIRE_EMAIL_VERIFICATION=true
# 仅本地联调用：SMTP 未配置时把验证码返回给前端（生产必须 false）
SMTP_DEBUG=false
